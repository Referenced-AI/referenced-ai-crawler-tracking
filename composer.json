{
    "name": "referenced/ai-crawler-tracking",
    "description": "Referenced - AI Crawler Tracking WordPress plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "pestphp/pest": "^3.0",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Referenced\\": "src/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "phpcs"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable"
}
